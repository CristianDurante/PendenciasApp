PENDENCIAS_ADMIN_SENHA=troque-por-uma-senha-forte

# Banco de dados (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres.hctsrehfjvffswxpgqmc:SUA_SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

