{
  "version": 2,
  "buildCommand": "prisma db push --skip-generate && npm run build:web",
  "outputDirectory": "out/renderer",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "prisma/schema.prisma"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}