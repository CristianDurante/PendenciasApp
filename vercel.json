{
  "version": 2,
  "buildCommand": "npm run build:web",
  "outputDirectory": "out/renderer",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "prisma/schema.prisma"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}