# Obrigatorio na primeira inicializacao em producao.
PENDENCIAS_ADMIN_EMAIL=admin@exemplo.com
PENDENCIAS_ADMIN_SENHA=troque-por-uma-senha-forte

# SMTP e necessario para recuperacao de senha.
PENDENCIAS_SMTP_HOST=smtp.exemplo.com
PENDENCIAS_SMTP_PORT=587
PENDENCIAS_SMTP_SECURE=0
PENDENCIAS_SMTP_USER=
PENDENCIAS_SMTP_PASS=
PENDENCIAS_SMTP_FROM=no-reply@exemplo.com

# Preencha somente se houver frontend em outra origem.
PENDENCIAS_CORS_ORIGIN=