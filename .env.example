# Obrigatorio na primeira inicializacao em producao.
PENDIFY_ADMIN_EMAIL=admin@exemplo.com
PENDIFY_ADMIN_SENHA=troque-por-uma-senha-forte

# SMTP e necessario para recuperacao de senha.
PENDIFY_SMTP_HOST=smtp.exemplo.com
PENDIFY_SMTP_PORT=587
PENDIFY_SMTP_SECURE=0
PENDIFY_SMTP_USER=
PENDIFY_SMTP_PASS=
PENDIFY_SMTP_FROM=no-reply@exemplo.com

# Preencha somente se houver frontend em outra origem.
PENDIFY_CORS_ORIGIN=